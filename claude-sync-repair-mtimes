#!/bin/bash
# Claude Code Conversation Sync - Repair mtimes
# Restores session file modification times from the timestamps recorded
# inside each conversation .jsonl file.
#
# Use this on a machine where synced sessions all show the same recent
# time in Claude Code's session picker (caused by pulls made before
# mtime preservation was added).

set -e

ORIGINAL_DIR="$(pwd)"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Load configuration
source "$SCRIPT_DIR/lib-claude-sync.sh"

# Handle --version flag
if [ "$1" = "--version" ] || [ "$1" = "-v" ]; then
    show_version "$SCRIPT_DIR" "claude-sync-repair-mtimes"
    exit 0
fi

load_config "$SCRIPT_DIR"

CLAUDE_DIR="$CLAUDE_DATA_DIR"

echo "=== Claude Code Conversation Sync - Repair mtimes ==="
echo "Repairing session times in: $CLAUDE_DIR/projects"
echo ""

if [ ! -d "$CLAUDE_DIR/projects" ]; then
    echo "Error: No projects directory found at $CLAUDE_DIR/projects"
    cd "$ORIGINAL_DIR"
    exit 1
fi

repaired=0
skipped=0

while IFS= read -r session; do
    # Timestamps appear on every entry; the last one is the session's
    # last activity. Check the tail of the file first to avoid reading
    # large sessions in full.
    ts=$(tail -c 262144 "$session" | grep -o '"timestamp":"[^"]*"' | tail -1 | cut -d '"' -f 4)
    if [ -z "$ts" ]; then
        ts=$(grep -o '"timestamp":"[^"]*"' "$session" | tail -1 | cut -d '"' -f 4)
    fi
    if [ -z "$ts" ]; then
        log_verbose "No timestamp found, skipping: $session"
        skipped=$((skipped + 1))
        continue
    fi

    epoch=$(iso_to_epoch "$ts")
    if [ -z "$epoch" ]; then
        log_verbose "Could not parse timestamp '$ts', skipping: $session"
        skipped=$((skipped + 1))
        continue
    fi

    if [ "$(file_mtime "$session")" != "$epoch" ]; then
        touch_epoch "$epoch" "$session"
        repaired=$((repaired + 1))
        log_verbose "Repaired: $session"
    fi
done < <(find "$CLAUDE_DIR/projects" -type f -name '*.jsonl')

echo "Repaired $repaired session file(s), skipped $skipped."
echo ""
echo "Note: Restart Claude Code to see the corrected session order."

cd "$ORIGINAL_DIR"
